# ==============================================================================
# SteamItemExchange (counter-shop) - Environment Variables
# ==============================================================================

# Core App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WS_URL="ws://localhost:3001"
NODE_ENV="development"
JWT_SECRET="super_secret_jwt_key_counter_shop_2026_dev_prod"

# Database Connection (PostgreSQL with Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/counter_shop?schema=public"

# Redis Cache & Rate Limiting
REDIS_URL="redis://localhost:6379"

# Steam Web API & OpenID Authentication
STEAM_API_KEY="YOUR_STEAM_WEB_API_KEY_HERE"
STEAM_REALM="http://localhost:3000"
STEAM_RETURN_URL="http://localhost:3000/api/auth/steam/return"

# Steam Bot Configuration (For Automated Trade Offers)
STEAM_BOT_ACCOUNT_NAME="counter_shop_tradebot"
STEAM_BOT_PASSWORD="bot_secure_password"
STEAM_BOT_SHARED_SECRET="STEAM_GUARD_SHARED_SECRET_BASE64=="
STEAM_BOT_IDENTITY_SECRET="STEAM_GUARD_IDENTITY_SECRET_BASE64=="
STEAM_BOT_STEAM_ID="76561198000000000"
STEAM_BOT_TRADE_URL="https://steamcommunity.com/tradeoffer/new/?partner=00000000&token=abcdefgh"

# Python FastAPI Steam Microservice
PYTHON_SERVICE_URL="http://localhost:8000"

# Optional External Price APIs (BUFF163, Skinport, IGXE)
BUFF163_API_KEY="optional_buff163_token"
SKINPORT_CLIENT_ID="optional_skinport_client_id"
SKINPORT_API_SECRET="optional_skinport_secret"
